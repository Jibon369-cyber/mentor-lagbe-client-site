# Client environment variables for MentorLagbe
# Copy this file to .env.local and fill in real values.

# Express API origin used by the Next.js rewrite proxy (server-side only).
API_URL=http://localhost:5000

# Public site URL (used for metadata / OAuth callbacks in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ImgBB browser upload key. Create one at https://api.imgbb.com/
NEXT_PUBLIC_IMGBB_KEY=your-imgbb-api-key
